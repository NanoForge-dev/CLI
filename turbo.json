{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "enabled": true
  },
  "globalDependencies": ["tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json", "tsdown.config.ts"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "build:dev": {
      "dependsOn": ["^build:dev"],
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json", "tsdown.config.ts"],
      "outputs": ["dist/**"],
      "outputLogs": "errors-only"
    },
    "format": {
      "dependsOn": ["^format"],
      "inputs": ["**"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["**"],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test:unit": {
      "dependsOn": ["^test:unit"],
      "inputs": [
        "src/**",
        "test/**",
        "package.json",
        "tsconfig.json",
        "tsdown.config.ts",
        "vitest.config.ts"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "test:e2e": {
      "dependsOn": ["build", "^test:e2e"],
      "inputs": [
        "src/**",
        "e2e/**",
        "package.json",
        "tsconfig.json",
        "tsdown.config.ts",
        "vitest.config.e2e.ts"
      ],
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "docs": {
      "dependsOn": ["^docs"],
      "inputs": ["src/**", "test/**", "package.json", "tsconfig.json", "../../docs/templates/**"],
      "outputs": ["../../docs/references/**"],
      "outputLogs": "errors-only"
    }
  }
}
