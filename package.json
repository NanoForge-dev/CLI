{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nanoforge-dev/cli",
  "version": "1.6.2",
  "description": "NanoForge CLI",
  "keywords": [
    "nanoforge",
    "game",
    "cli"
  ],
  "homepage": "https://github.com/NanoForge-dev/CLI#readme",
  "bugs": "https://github.com/NanoForge-dev/cli/issues",
  "license": "MIT",
  "contributors": [
    "Bill <timothe.jacquot@epitech.eu>",
    "Exelo <contact@exelo.dev>",
    "Fexkoser <martin.fillon@epitech.eu>",
    "Josephine <josephine.chicouras@epitech.eu>",
    "Tchips <leo.outmizguine@epitech.eu>"
  ],
  "files": [
    "dist"
  ],
  "bin": {
    "nf": "dist/nf.js"
  },
  "type": "module",
  "directories": {
    "lib": "src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanoForge-dev/CLI.git"
  },
  "funding": "https://github.com/NanoForge-dev/CLI?sponsor",
  "scripts": {
    "build": "turbo run build --concurrency=5 --filter='!@nanoforge-dev/cli' && tsc --noEmit && tsdown",
    "build:dev": "turbo run build --concurrency=5 --filter='!@nanoforge-dev/cli' && tsc --noEmit && NODE_ENV=development tsdown",
    "start": "node dist/nf.js",
    "lint": "prettier --check . && eslint --format=pretty src && turbo run lint --concurrency=5 --filter='!@nanoforge-dev/cli'",
    "format": "prettier --write . && eslint --fix --format=pretty src && turbo run format --concurrency=5 --filter='!@nanoforge-dev/cli'",
    "prepack": "pnpm run build && pnpm run lint",
    "changelog": "git cliff --prepend ./CHANGELOG.md -u -c ./cliff.toml -r . --include-path '.'",
    "release": "cliff-jumper",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run -c vitest.config.ts && turbo run test:unit --concurrency=5 --filter='!@nanoforge-dev/cli'",
    "test:unit:watch": "vitest -c vitest.config.ts",
    "test:e2e": "vitest run -c vitest.config.e2e.ts",
    "test:e2e:watch": "vitest -c vitest.config.e2e.ts",
    "test:coverage": "pnpm run test:unit --coverage && pnpm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@angular-devkit/schematics": "catalog:schematics",
    "@angular-devkit/schematics-cli": "catalog:schematics",
    "@inquirer/prompts": "catalog:cli",
    "@nanoforge-dev/loader-client": "catalog:loader",
    "@nanoforge-dev/loader-server": "catalog:loader",
    "@nanoforge-dev/schematics": "catalog:schematics",
    "ansis": "catalog:cli",
    "bun": "catalog:core",
    "chokidar": "catalog:libs",
    "class-transformer": "catalog:libs",
    "class-validator": "catalog:libs",
    "commander": "catalog:cli",
    "dotenv": "catalog:libs",
    "node-emoji": "catalog:cli",
    "open": "catalog:libs",
    "ora": "catalog:cli",
    "rc9": "catalog:libs",
    "reflect-metadata": "catalog:libs"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:ci",
    "@commitlint/config-conventional": "catalog:ci",
    "@favware/cliff-jumper": "catalog:ci",
    "@nanoforge-dev/actions": "catalog:ci",
    "@nanoforge-dev/utils-eslint-config": "catalog:lint",
    "@nanoforge-dev/utils-prettier-config": "catalog:lint",
    "@trivago/prettier-plugin-sort-imports": "catalog:lint",
    "@types/inquirer": "catalog:cli",
    "@types/node": "catalog:core",
    "@vitest/coverage-v8": "catalog:test",
    "eslint": "catalog:lint",
    "husky": "catalog:ci",
    "lint-staged": "catalog:ci",
    "prettier": "catalog:lint",
    "tsdown": "catalog:build",
    "turbo": "catalog:build",
    "typescript": "catalog:build",
    "vitest": "catalog:test"
  },
  "optionalDependencies": {
    "@nanoforge-dev/editor": "catalog:core"
  },
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": "26"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "**": [
      "prettier --ignore-unknown --write"
    ],
    "src/**/*.ts": [
      "eslint --fix"
    ]
  }
}
